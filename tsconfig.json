{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "allowJs": false,
    "removeComments": true,
    "noEmitHelpers": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "library.ts",
    "books/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.js"
  ]
}